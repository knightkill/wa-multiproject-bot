# wa-multiproject-bot configuration.
#
# The app reads these from the process environment directly — there is NO
# dotenv auto-loading. Export them in your shell or process manager, or (in
# production) set them as Fly secrets / [env]. Copying this file to .env is a
# personal reference only; it will not be loaded automatically.

# REQUIRED. Bearer token guarding the admin UI/API and the /qr pairing page.
# Generate a strong one: openssl rand -hex 32
ADMIN_TOKEN=

# Where Baileys stores the paired-session credentials. Treat as a secret:
# possession of this directory is full control of the WhatsApp account.
AUTH_DIR=./auth-state

# SQLite path (projects, allowlists, message log, inbound capture).
DB_PATH=./wp.db

# HTTP port.
PORT=8080

# Log level: trace|debug|info|warn|error|fatal
LOG_LEVEL=info

# The DM recipient allowlist (the 403 gate) is ON unless this is exactly
# "false". Leaving it unset keeps the safe default; set "false" only to let
# 1:1 DMs reach any recipient (caps + jitter + auto-pause still apply).
# DM_ALLOWLIST_ENABLED=true

# Server-side DM throttle knobs (NOT settable by API callers). Defaults shown.
# DM_JITTER_MIN_MS=60000
# DM_JITTER_MAX_MS=180000
# DM_CAP_PER_MIN=1
# DM_CAP_PER_DAY=30

# Rate limiter trusts Fly's fly-client-ip by default. Set "true" ONLY when
# running behind another reverse proxy that sets a trustworthy
# X-Forwarded-For; otherwise the limiter falls back to the socket address.
# TRUST_XFF=false
